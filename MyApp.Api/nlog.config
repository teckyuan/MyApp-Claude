<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="logDir" value="${basedir}/logs" />
  <variable name="minLevel" value="Info" />
  <variable name="layout"
            value="${longdate} ${level:uppercase=true:padding=-5} [${logger:shortName=true}] ${message} ${exception:format=tostring} ${when:when=length('${aspnet-TraceIdentifier}')>0:inner=(trace ${aspnet-TraceIdentifier})}" />

  <!-- Errors file: one block per exception with request context, type, stack trace and inner exceptions. -->
  <variable name="errorLayout" value="${longdate} ${level:uppercase=true} [${logger}]${newline}  Message : ${message}${newline}  Request : ${aspnet-request-method} ${aspnet-request-url:IncludeQueryString=false}${newline}  TraceId : ${aspnet-TraceIdentifier}${newline}  Exception: ${exception:format=Type,Message,Data,StackTrace:innerFormat=Type,Message,StackTrace:maxInnerExceptionLevel=5:separator= | }${newline}" />

  <targets async="true">
    <target xsi:type="File" name="errors"
            fileName="${logDir}/myapp-errors-${shortdate}.log"
            layout="${errorLayout}"
            archiveAboveSize="10485760"
            maxArchiveFiles="30"
            keepFileOpen="false" />
    <target xsi:type="Console" name="console" layout="${layout}" />
    <target xsi:type="File" name="file"
            fileName="${logDir}/myapp-${shortdate}.log"
            layout="${layout}"
            archiveAboveSize="10485760"
            maxArchiveFiles="14"
            keepFileOpen="false" />
  </targets>

  <rules>
    <!-- Framework noise: warnings and above only. Final stops it falling through to the catch-all. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Error" writeTo="errors" />
    <logger name="*" minlevel="${var:minLevel}" writeTo="console,file" />
  </rules>
</nlog>
